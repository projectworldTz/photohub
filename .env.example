APP_NAME=PhotoHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Nairobi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Future provider integrations (leave blank until configured)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
PAYMENT_DRIVER=manual
PAYMENT_CALLBACK_SECRET=
SMS_DRIVER=null
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_DRIVER=null
WHATSAPP_TOKEN=
AI_SERVICES_ENABLED=false
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# cloud (existing SaaS), local, or hybrid
PHOTOHUB_MODE=cloud
PHOTOHUB_LOCAL_STORAGE_PATH=
PHOTOHUB_CLOUD_ENABLED=false
PHOTOHUB_CLOUD_URL=
PHOTOHUB_LOCAL_BUSINESS_ID=0
PHOTOHUB_STUDIO_TOKEN=
PHOTOHUB_ALLOW_HTTP=false
PHOTOHUB_AUTO_SELECTIONS=true
