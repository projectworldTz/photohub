APP_NAME=PhotoHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://photohub.projectworldtz.com
APP_TIMEZONE=Africa/Nairobi

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_DATABASE_NAME
DB_USERNAME=CPANEL_DATABASE_USER
DB_PASSWORD=CHOOSE_A_STRONG_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=photohub.projectworldtz.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=hello@projectworldtz.com
MAIL_FROM_NAME="${APP_NAME}"

PAYMENT_DRIVER=manual
SMS_DRIVER=null
WHATSAPP_DRIVER=null
AI_SERVICES_ENABLED=false
